JIRA_URL=https://your-instance.atlassian.net
OUTPUT_DIR=./exported-issues

# Optional: override the JQL used to select issues (default: assignee = currentUser())
# JIRA_JQL=project = ABC AND updated >= -30d

# Saved browser session file. Leave unset for the default (.jira-session.json);
# set to an empty value to always log in interactively.
# JIRA_STATE_FILE=.jira-session.json

# Download every attachment of every issue into <issue>/attachments/ (1 = on).
# Images embedded in descriptions and comments are downloaded either way.
# JIRA_DOWNLOAD_ATTACHMENTS=0
# Skip attachments larger than this many MB.
# JIRA_MAX_ATTACHMENT_MB=25

# Retries after the first attempt when Jira rate-limits a request (0-10).
# The exporter honours Retry-After and paces itself down after a throttle.
# JIRA_MAX_RETRIES=4

# Optional custom-field ID overrides. By default Sprint, Story Points (or Story
# point estimate), and Epic Link are discovered from Jira's field catalog.
# Set one when your instance has a renamed or duplicate field.
# JIRA_SPRINT_FIELD_ID=customfield_10020
# JIRA_STORY_POINTS_FIELD_ID=customfield_10016
# JIRA_EPIC_LINK_FIELD_ID=customfield_10014
